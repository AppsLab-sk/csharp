<Window x:Class="HotColdGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cvicenie_first_WPF"
        Title="Hot / Cold"
        Height="448"
        Width="1024">

    <Canvas>

        <TextBlock Text="Hot / Cold (1–100)"
                   FontSize="20"
                   FontWeight="Bold"
                   Canvas.Left="70"
                   Canvas.Top="20" />

        <TextBlock Text="Uhádni tajné číslo 1–100."
                   Canvas.Left="75"
                   Canvas.Top="55" />

        <TextBox x:Name="zadanie"
                 Width="200"
                 Height="43"
                 Canvas.Left="312"
                 Canvas.Top="130"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top" />

        <Button Content="Skús"
                Width="91"
                Height="43"
                Canvas.Left="512"
                Canvas.Top="130"
                Click="Skus"
                RenderTransformOrigin="0.488,0.585"
                FontSize="24"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" />

        <TextBlock x:Name="Feedback"
                   FontSize="16"
                   Canvas.Left="328"
                   Canvas.Top="188"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Width="168" />

        <TextBlock x:Name="Attempts"
                   Text="Počet pokusov: 0"
                   Canvas.Left="114"
                   Canvas.Top="294"
                   FontSize="24" />

        <Button Content="Reset"
                Width="382"
                Height="30"
                Canvas.Left="286"
                Canvas.Top="369"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="24" />

    </Canvas>
</Window>
