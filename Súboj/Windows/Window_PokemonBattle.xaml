<Window x:Class="PokemonGame.Windows.Window_PokemonBattle" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:PokemonGame.Windows" mc:Ignorable="d" Title="Window_PokemonBattle" Height="600" Width="800">
    <Grid Background="#FFE4D1D1">
        <Image Margin="512,122,57,240" Source="/Images/Charizard.png" Stretch="Fill" />
        <Image Margin="0,122,404,240" Source="/Images/Pikachu.png" Stretch="Fill" />
        <ProgressBar Name="ProgressBar_Pokemon1_HP" HorizontalAlignment="Left" Height="42" Margin="25,372,0,0" VerticalAlignment="Top" Width="360" />
        <Label x:Name="Label_Pokemon1_HP" Content="X/X" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="25,419,0,0" VerticalAlignment="Top" Height="37" Width="360" FontSize="20" />
        <ProgressBar x:Name="ProgressBar_Pokemon2_HP" HorizontalAlignment="Left" Height="42" Margin="420,373,0,0" VerticalAlignment="Top" Width="360" />
        <Label x:Name="Label_Pokemon2_HP" Content="X/X" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="420,420,0,0" VerticalAlignment="Top" Height="37" Width="360" FontSize="20" />

        <Button Name ="Button_LA" Content="Light Attack" HorizontalAlignment="Left" Margin="25,482,0,0" VerticalAlignment="Top" Height="42" Width="111" Background="#FFA2F990" Click="Button_Click" />
        <Button Name ="Button_MA" Content="Medium Attack" HorizontalAlignment="Left" Margin="141,482,0,0" VerticalAlignment="Top" Height="42" Width="121" Background="#FFF9F090" Click="Button_Click_1" />
        <Button Name ="Button_HA" Content="High Attack" HorizontalAlignment="Left" Margin="267,482,0,0" VerticalAlignment="Top" Height="42" Width="118" Background="#FFF99090" Click="Button_Click_2" />
        <Button Name ="Button_Heal" Content="Heal" HorizontalAlignment="Left" Margin="141,532,0,0" VerticalAlignment="Top" Height="42" Width="121" Background="#FFF990F0" Click="Button_Click_3" />
        <ListView x:Name="ListView_FightLogger" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="25,0,290,496" Background="White">
            <ListView.View>
                <GridView>
                    <GridViewColumn />
                </GridView>
            </ListView.View>
        </ListView>


    </Grid>
</Window>
