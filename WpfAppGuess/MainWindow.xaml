<Window x:Class="secondwpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:secondwpf"
        mc:Ignorable="d"
        Title="Hot / Cold"
        Height="450"
        Width="800"
        Background="Gray">
    <Grid>
        <TextBlock HorizontalAlignment="Center"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Text="  Hot / Cold (0 - 100)"
                   VerticalAlignment="Top"
                   Height="45"
                   Width="242"
                   FontSize="24"
                   Foreground="Black"
                   Background="#FFC73D3D" />
        <TextBlock HorizontalAlignment="Left"
                   Margin="43,84,0,0"
                   TextWrapping="Wrap"
                   Text="Guess the number between 0 and 100!"
                   VerticalAlignment="Top"
                   Height="32"
                   Width="411"
                   FontSize="24" />
        <TextBox HorizontalAlignment="Left"
                 Margin="343,271,0,0"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Width="120"
                 Height="37"
                 Background="#FF0E0E0E"
                 Foreground="#FF73FF4C"
                 FontSize="24"
                 Name="TextBox_number" />
        <Button Content="Test"
                HorizontalAlignment="Left"
                Margin="495,280,0,0"
                VerticalAlignment="Top"
                Height="28"
                Width="48"
                Click="Button_Click_Test" />
        <TextBlock Name="Info"
                   HorizontalAlignment="Left"
                   Margin="209,365,0,0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Height="47"
                   Width="194"
                   FontSize="36" />
        <TextBlock Name="guessis" 
            HorizontalAlignment="Left"
                   Margin="68,180,0,0"
                   TextWrapping="Wrap"
                   Text="Number of attempts:"
                   VerticalAlignment="Top"
                   Height="42"
                   Width="226"
                   FontSize="24" />
        <Button Name="Reset"
                Content="Reset"
                HorizontalAlignment="Left"
                Margin="26,389,0,0"
                VerticalAlignment="Top"
                Height="35"
                Width="146"
                Click="Reset_Click" />
        <TextBlock Name="Guesses"
                   HorizontalAlignment="Left"
                   Margin="274,156,0,0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Height="42"
                   FontSize="36"
                   Width="40" />

    </Grid>
</Window>