<Window x:Class="WpfAppStopky.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppStopky"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800">
    <Grid>
        <TextBox Name="TipTextBox"
            HorizontalAlignment="Center"
                 Margin="0,182,0,0"
                 TextWrapping="Wrap"
                 Text="TextBox"
                 VerticalAlignment="Top"
                 Width="120"
                 FontSize="25" />
        <Label Name="ResultLabel"
            Content="Label"
               HorizontalAlignment="Center"
               Margin="0,301,0,0"
               VerticalAlignment="Top"
               FontSize="20" />
        <Button Name="StartButton"
                Content="Start"
                HorizontalAlignment="Left"
                Margin="147,59,0,0"
                VerticalAlignment="Top"
                FontSize="25" />
        <Button Name="StopButton"
            Content="Stop"
                HorizontalAlignment="Left"
                Margin="147,146,0,0"
                VerticalAlignment="Top"
                FontSize="25" />
        <Button Name="CheckTipButton"
            Content="tip"
                HorizontalAlignment="Left"
                Margin="597,67,0,0"
                VerticalAlignment="Top"
                FontSize="25"
                Click="CheckTipButton_Click" />
        <Button Content="Button"
                HorizontalAlignment="Left"
                Margin="597,156,0,0"
                VerticalAlignment="Top"
                FontSize="25" />
        <RadioButton Content="Milisekundy"
                     HorizontalAlignment="Left"
                     Margin="159,274,0,0"
                     VerticalAlignment="Top" />
        <RadioButton Content="Sekundy"
                     HorizontalAlignment="Left"
                     Margin="528,274,0,0"
                     VerticalAlignment="Top" />

    </Grid>
</Window>
